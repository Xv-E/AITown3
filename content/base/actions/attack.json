{
  "name": "attack",
  "capability": "attack",
  "description": "Attack someone at the same location: damage = your power + your best weapon - their armour; at 0 HP they die and drop everything",
  "duration": 1.5,
  "params": [
    { "name": "attacker", "type": "Person", "source": "self" },
    { "name": "target", "type": "Person", "source": "people_here" },
    { "name": "l", "type": "Location", "source": "here" }
  ],
  "requires": [
    { "op": "neq", "a": "@attacker", "b": "@target", "message": "Cannot attack yourself" },
    { "op": "prop_gte", "entity": "@attacker", "label": "Person", "prop": "hp", "value": 1, "message": "@attacker is dead" },
    { "op": "prop_gte", "entity": "@target", "label": "Person", "prop": "hp", "value": 1, "message": "@target is dead" },
    { "op": "person_at", "person": "@attacker", "location": "@l" },
    { "op": "person_at", "person": "@target", "location": "@l" }
  ],
  "effects": [
    { "op": "strike", "attacker": "@attacker", "target": "@target" }
  ],
  "pddl_preconditions": ["(alive ?attacker)", "(alive ?target)", "(at ?attacker ?l)", "(at ?target ?l)"],
  "pddl_effects": ["(decrease (hp ?target) (power_level ?attacker))"]
}
