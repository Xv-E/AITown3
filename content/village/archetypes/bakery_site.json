{
  "archetype": "bakery_site",
  "extends": "construction_site",
  "name": "BakerySite",
  "footprint": [3, 2],
  "description": "Foundations for a Bakery. Needs planks and stone.",
  "blueprint": {
    "label": "Bakery",
    "description": "Bakes wheat into bread. Needs 8 planks, 5 stone. Requires a Workshop.",
    "zone_tags": ["build"],
    "requires": [
      { "op": "count", "archetype": "workbench", "gte": 1, "message": "Build a Workshop first" }
    ],
    "order": 20
  },
  "script": {
    "initial_state": { "need_plank": 8, "need_stone": 5 },
    "on_tick": [
      {
        "op": "rule",
        "id": "built",
        "when": [
          { "op": "prop_lte", "entity": "@self", "prop": "need_plank", "value": 0 },
          { "op": "prop_lte", "entity": "@self", "prop": "need_stone", "value": 0 }
        ],
        "do": [
          { "op": "spawn_item", "archetype": "oven", "located_at": "@here", "x": "@self.x", "y": "@self.y" },
          { "op": "delete_entity", "entity": "@self" }
        ],
        "announce": "A Bakery is finished in @here! Its oven bakes wheat into bread."
      }
    ]
  }
}
