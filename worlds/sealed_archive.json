  "facts": [
    {
      "name": "CourierBrief",
      "text": "You were hired to recover sealed records from the town archive. You do not yet know how the doors open. People at the Tavern often hear useful gossip.",
      "secret_level": 0,
      "known_by": [
        "Traveler"
      ]
    },
    {
      "name": "AskTorForCrowbar",
      "text": "BlacksmithTor at the Workshop keeps a Crowbar by the forge. It can pry open the Courtyard Trapdoor.",
      "secret_level": 0,
      "known_by": [
        "InnkeeperMara",
        "BlacksmithTor"
      ]
    },
    {
      "name": "TrapdoorLeadsToCellar",
      "text": "The rusted Trapdoor in the Courtyard leads down into a Cellar once forced open.",
      "secret_level": 0,
      "known_by": [
        "InnkeeperMara",
        "GuardRenn",
        "BlacksmithTor"
      ]
    },
    {
      "name": "KeyInCellar",
      "text": "A RustyKey that opens ArchiveDoor is hidden in the Cellar under the Courtyard Trapdoor.",
      "secret_level": 1,
      "known_by": [
        "InnkeeperMara",
        "ScholarElise"
      ]
    },
    {
      "name": "EliseNeedsSalve",
      "text": "ScholarElise is hurt in ArchiveAntechamber. HealingSalve from MarketSquare can restore her so she can talk clearly.",
      "secret_level": 0,
      "known_by": [
        "InnkeeperMara"
      ]
    },
    {
      "name": "EliseKnowsArchiveDoor",
      "text": "ArchiveDoor will only open with the RustyKey from the Cellar. After that you can enter SealedArchive.",
      "secret_level": 1,
      "known_by": [
        "ScholarElise"
      ]
    },
    {
      "name": "SealStampsWarrant",
      "text": "BrassSeal from the Cellar can stamp BlankWarrant found at the Tavern. The stamped warrant may calm GuardRenn.",
      "secret_level": 1,
      "known_by": [
        "InnkeeperMara"
      ]
    },
    {
      "name": "PotionAtMarket",
      "text": "A Potion on MarketSquare can be drunk (Use item) to heal yourself if you are injured.",
      "secret_level": 0,
      "known_by": [
        "InnkeeperMara"
      ]
    },
    {
      "name": "LanternIsDecoy",
      "text": "The Lantern in the Workshop is ordinary and does not open any doors.",
