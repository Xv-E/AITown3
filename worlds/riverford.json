{
  "id": "riverford",
  "title": "Riverford",
  "premise": "A walled river town. The square, the market row and the docks are inside the palisade; a bridge crosses to the meadow and the quarry road, the west gate opens on the forest and the south gate on the fields. Beneath the guild hall lies a crypt the guildmaster sealed years ago. The town watch keeps the peace; a wolf hunts the meadow across the bridge.",
  "locations": [
    {
      "name": "Fields",
      "description": "Wheat and vegetable plots outside the south gate, with the granary.",
      "tags": "work,food"
    },
    {
      "name": "Forest",
      "description": "Old pines wrap the town on the west and north; a dirt road leads out from the west gate.",
      "tags": "work,wood,food,wild"
    },
    {
      "name": "Market",
      "description": "Market Row runs from the square down to the docks, lined with stalls.",
      "tags": "trade,build"
    },
    {
      "name": "Meadow",
      "description": "Open grassland across the bridge; the road climbs north to the quarry.",
      "tags": "wild"
    },
    {
      "name": "Quarry",
      "description": "A grey scar of broken stone in the northern hills.",
      "tags": "work,stone"
    },
    {
      "name": "RiverDocks",
      "description": "Plank docks along the river, a fishing pier, and the bridge to the east bank.",
      "tags": "work,water,social"
    },
    {
      "name": "TownSquare",
      "description": "A cobbled square inside the palisade, ringed by the tavern, the guild hall, the smithy and the chapel.",
      "tags": "hub,social,build"
    },
    {
      "name": "Chapel",
      "description": "A small stone chapel, quiet except for the bell.",
