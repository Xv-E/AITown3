      "indoor": true,
      "parent": "TownSquare"
    },
    {
      "name": "Crypt",
      "description": "Below the guild hall: cold stone and something that should have stayed sealed.",
      "tags": "dungeon,danger",
      "indoor": true,
      "parent": "TownSquare"
    },
    {
      "name": "Granary",
      "description": "Where the harvest is stored, dry and guarded from rats.",
